# Copy to `.env.local` and fill in real values (Next.js reads `.env.local` locally; do not commit it).
# This file documents variables only — no secrets here.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: override Brain Mirror only (otherwise it always uses gpt-5.5).
# OPENAI_MIRROR_MODEL=

# App — must match the URL you open (same host + port Next prints in the terminal).
# If Next uses 3000 instead, set http://localhost:3000 here and use that in the browser.
# Add the same origin in Supabase → Authentication → URL Configuration (Site URL + Redirect URLs),
# including /auth/callback (e.g. http://localhost:3001/auth/callback).
#
# Sign-up without email verification (free): Supabase Dashboard → Authentication → Providers → Email
# → turn OFF "Confirm email". Users can sign up and continue immediately.
NEXT_PUBLIC_APP_URL=http://localhost:3001
